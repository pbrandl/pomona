{
  "name": "pomona",
  "productName": "Pomona",
  "version": "0.3.0",
  "description": "Dezentrale Bietrunde: Pears + WDK + Escrow-Contract",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.js",
    "test": "node --test test/*.test.js",
    "preview": "node scripts/preview.js",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "pear": "pear run --dev .",
    "ui-check": "node scripts/ui-check.js"
  },
  "pear": {
    "name": "pomona",
    "type": "desktop",
    "pre": "pear-electron/pre",
    "gui": {
      "main": "index.html",
      "width": 1040,
      "height": 720,
      "minWidth": 720,
      "minHeight": 560,
      "backgroundColor": "#F7F6F2"
    },
    "stage": {
      "ignore": [
        ".git",
        "test",
        "scripts",
        "preview.html",
        ".ui-check"
      ],
      "entrypoints": [
        "/worker/index.js"
      ]
    }
  },
  "dependencies": {
    "@qvac/inference": "^0.22.0",
    "@qvac/langdetect-text": "^0.1.3",
    "@qvac/llm-llamacpp": "^0.61.2",
    "@tetherto/wdk": "^1.0.0-beta.22",
    "@tetherto/wdk-wallet-evm": "^1.0.0-beta.24",
    "@tetherto/wdk-wallet-evm-erc-4337": "^1.0.0-beta.23",
    "b4a": "^1.9.0",
    "bare-node-runtime": "^1.5.3",
    "corestore": "^7.16.1",
    "ethers": "^6.17.0",
    "hyperbee": "^2.27.3",
    "hyperswarm": "^4.17.2",
    "idiomorph": "^0.7.3",
    "pear-bridge": "^1.2.5",
    "pear-electron": "^1.7.28",
    "pear-pipe": "^1.0.6",
    "pear-restart": "^1.0.0",
    "pear-run": "^2.0.0",
    "pear-updates": "^1.1.0",
    "qrcode-generator": "^2.0.4",
    "sodium-universal": "^5.0.1"
  },
  "devDependencies": {
    "bare-runtime": "^1.36.0",
    "hyperdht": "^6.35.0",
    "playwright": "1.63.0",
    "standard": "^17.1.2"
  },
  "standard": {
    "globals": [
      "Pear",
      "Bare"
    ],
    "ignore": [
      "core/chain/abi.js",
      "core/config/deployments.js",
      "core/bare.js",
      "test/bare-smoke.js",
      "ui/vendor/"
    ]
  }
}
